#cloud-config
## template: jinja
hostname: {{ hostname }}
manage_etc_hosts: true

{% if proxy %}
apt:
  http_proxy: "{{ proxy.http }}"
  https_proxy: "{{ proxy.https }}"
{% endif %}

users:
  - name: {{ username }}
    groups: sudo
    shell: /bin/bash
    sudo: ['ALL=(ALL) NOPASSWD:ALL']
    lock_passwd: false
    passwd: "{{ password_hash | default('') }}"

package_update: true
package_upgrade: true
packages:
  - apt-transport-https
  - ca-certificates
  - curl
  - gnupg2
  - software-properties-common
  - python3
  - python3-pip
  - openjdk-21-jdk
  - npm

write_files:
{% if proxy %}
  - path: /etc/instance.d/proxy.sh
    permissions: '0644'
    content: |
      export http_proxy="{{ proxy.http }}"
      export https_proxy="{{ proxy.https }}"
      export no_proxy="{{ proxy.no_proxy }}"
{% endif %}
{% if proxy %}
  - path: /etc/apt/apt.conf.d/95proxies
    permissions: '0644'
    content: |
      Acquire::http::Proxy "{{ proxy.http }}";
      Acquire::https::Proxy "{{ proxy.https }}";
{% endif %}
  - path: /usr/lib/binfmt.d/WSLInterop.conf
    permissions: '0644'
    content: |
      :WSLInterop:M::MZ::/init:PF
  - path: /etc/wsl.conf
    permissions: '0644'
    content: |
      [boot]
      systemd=true
      [automount]
      options = "metadata"
      [interop]
      appendWindowsPath = true
      [user]
      default={{ username }}

runcmd:
{% if proxy %}
  - export http_proxy="{{ proxy.http }}"
  - export https_proxy="{{ proxy.https }}"
  - export no_proxy="{{ proxy.no_proxy }}"
  - git config --system http.proxy "{{ proxy.http }}"
  - git config --system https.proxy "{{ proxy.https }}"
{% endif %}
  - curl -fsSL https://get.docker.com | sh
  - usermod -aG docker {{ username }}
  - systemctl enable docker
  - systemctl start docker
  - apt install -y docker-compose-plugin
  - |
    for port in 16443 6443 6444; do
      if ss -tlnp | grep -qE ":${port}[[:space:]]"; then
        echo "ERROR: port ${port} is already in use — another WSL instance may be running a Kubernetes service. Aborting to avoid infinite wait." >&2
        exit 1
      fi
    done
  - snap install microk8s --classic
  - usermod -a -G microk8s {{ username }}
  - mkdir -p /home/{{ username }}/.kube
  - microk8s status --wait-ready
  - microk8s config > /home/{{ username }}/.kube/config
  - chown -R {{ username }}:{{ username }} /home/{{ username }}/.kube
  - snap install kubectl --classic

final_message: "✅ cloud-init finished on {{ hostname }}."
